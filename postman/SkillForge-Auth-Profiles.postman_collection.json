{
  "info": {
    "name": "SkillForge - Auth & Profiles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders top to bottom. Register/Login store the JWT in the 'token' collection variable automatically."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "skillId",
      "value": ""
    },
    {
      "key": "profileSkillId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "certId",
      "value": ""
    },
    {
      "key": "expId",
      "value": ""
    },
    {
      "key": "revokedToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"usn\": \"NNM24CS001\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - duplicate email (409)",
          "request": {
